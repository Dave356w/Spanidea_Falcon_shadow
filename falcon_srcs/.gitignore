.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Serial captures from `pio device monitor --filter log2file`.
#
# These are working data, not evidence: a session produces hundreds of KB and
# every reflash restarts millis(), so a file is only meaningful alongside the
# notes describing which runs it holds. Captures worth keeping are quoted
# inline in Eng_Notes/ with the numbers already extracted, the way the July
# EFT captures were.
logs/

# Python bytecode from the graph/ replay tools.
#
# graph/__pycache__/parse_falcon_log.cpython-311.pyc was tracked and therefore
# showed as permanently modified: a .pyc is rewritten whenever the interpreter
# reloads the module, and the replay scripts are run constantly -- they are the
# evidence path for every refuted approach on file. Nothing here is source.
__pycache__/
*.py[cod]
